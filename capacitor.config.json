{
  "appId": "com.junglerider.game",
  "appName": "Jungle Rider",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "backgroundColor": "#0b1d10"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0b1d10",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
